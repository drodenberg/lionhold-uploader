{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lionhold Uploader",
  "version": "0.1.5",
  "identifier": "com.lionholdarmory.uploader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Armory Hall Uploader",
        "width": 440,
        "height": 600,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Uploads your WoW Forever bags to Armory Hall",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwRkEwOUI0QUI5OEQwNzUKUldSMTBKaXJ0QW42c05SeU5LOGQra2YwZ1pmaDhBVjNpQ3Q5NENMUVhEUHVIZklCSVV1cFhvK1EK",
      "endpoints": [
        "https://github.com/drodenberg/lionhold-uploader/releases/latest/download/latest.json",
        "https://armoryhall.app/uploader/latest.json",
        "https://lionhold-armory.drodenberg92.workers.dev/uploader/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
